<?xml version="1.0" encoding="UTF-8"?>
<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../Interface.xsd">
    <Assets>
        <Texture name="GearPreviewIcon" file="Textures/GearPreview.tga" />
    </Assets>
    <Windows>
        <!--
            The paperdoll button: a 36x36 icon, the height of
            CharacterWindowTitleBar. Lua creates it from this template as a
            child of CharacterWindow and anchors it in the title bar's right
            side, 116 left of its right edge: ClosetGoblin puts its 36x36 icon
            at 76 left of the same edge (the close button takes the corner),
            so this one sits 4 left of it, clear of the figure and of every
            slot. The face is the addon's own icon (GearPreviewIcon, set in
            Lua), 36x36 in the client's icon frame; the name is in the tooltip.

            The barber button: Lua creates a second one from this template as
            a child of EA_Window_BarbershopMain, the frame of the stock barber
            window, so it shows and hides with the barber. Its left edge's
            middle sits 10 right of the Check Out button's top right corner,
            which centres it on the Reset and Check Out pair (Reset sits on top
            of Check Out), below the mirror and left of the feature combo
            boxes, which start at x 915 of the 1530 wide frame.
        -->
        <Button name="GearPreviewButtonTemplate" layer="popup" handleinput="true">
            <Size><AbsPoint x="36" y="36" /></Size>
            <EventHandlers>
                <EventHandler event="OnLButtonUp" function="GearPreview.OnButton" />
                <EventHandler event="OnMouseOver" function="GearPreview.OnButtonMouseOver" />
                <EventHandler event="OnMouseOverEnd" function="GearPreview.OnButtonMouseOverEnd" />
            </EventHandlers>
            <Windows>
                <DynamicImage name="$parentIcon" handleinput="false">
                    <Size><AbsPoint x="36" y="36" /></Size>
                    <Anchors><Anchor point="center" relativePoint="center" relativeTo="$parent" /></Anchors>
                    <TexCoords x="0" y="0" />
                    <TexDims x="36" y="36" />
                </DynamicImage>
                <FullResizeImage name="$parentFrame" inherits="EA_Button_ResizeIconFrameNormal" handleinput="false">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent" />
                        <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent" />
                    </Anchors>
                </FullResizeImage>
                <FullResizeImage name="$parentHighlight" inherits="EA_Button_ResizeIconFrameHighlight" handleinput="false" show="false">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent" />
                        <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent" />
                    </Anchors>
                </FullResizeImage>
            </Windows>
        </Button>

        <!--
            The link window. Movable, saves no settings, created on first
            open. The sizes below are the layout with a one-line count. On
            each open Lua sizes Count to its text (it wraps only when the text
            is wider than 470), puts the link box 6 below it and sets the
            window height to fit.
        -->
        <Window name="GearPreviewWindow" inherits="EA_Window_Default" movable="true" savesettings="false" handleinput="true" layer="secondary" show="false">
            <Size><AbsPoint x="520" y="320" /></Size>
            <Anchors><Anchor point="center" relativePoint="center" relativeTo="Root" /></Anchors>
            <EventHandlers>
                <EventHandler event="OnKeyEscape" function="GearPreview.Close" />
            </EventHandlers>
            <Windows>
                <Window name="$parentBackground" inherits="EA_Window_DefaultBackgroundFrame" />
                <Window name="$parentTitleBar" inherits="EA_TitleBar_Default" />
                <Button name="$parentClose" inherits="EA_Button_DefaultWindowClose">
                    <EventHandlers><EventHandler event="OnLButtonUp" function="GearPreview.Close" /></EventHandlers>
                </Button>
                <Label name="$parentName" inherits="EA_Label_DefaultSubHeading" textalign="left" handleinput="false" wordwrap="false">
                    <Size><AbsPoint x="470" y="28" /></Size>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent"><AbsPoint x="25" y="50" /></Anchor>
                    </Anchors>
                </Label>
                <Label name="$parentCount" inherits="EA_Label_DefaultText" textalign="left" handleinput="false" wordwrap="true">
                    <Size><AbsPoint x="470" y="24" /></Size>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent"><AbsPoint x="25" y="80" /></Anchor>
                    </Anchors>
                </Label>
                <EditBox name="$parentLink" inherits="EA_EditBox_DefaultFrame_Multiline" scrolling="vert" scrollbar="EA_ScrollBar_DefaultVerticalChain" handleinput="true" maxchars="4000" font="font_default_text_small">
                    <Size><AbsPoint x="470" y="120" /></Size>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent"><AbsPoint x="25" y="110" /></Anchor>
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnKeyEscape" function="GearPreview.Close" />
                    </EventHandlers>
                </EditBox>
                <Label name="$parentHint" font="font_default_text_small" textalign="left" handleinput="false" wordwrap="false">
                    <Size><AbsPoint x="320" y="24" /></Size>
                    <Anchors>
                        <Anchor point="bottomleft" relativePoint="bottomleft" relativeTo="$parent"><AbsPoint x="25" y="-24" /></Anchor>
                    </Anchors>
                    <Color r="185" g="185" b="170" />
                </Label>
                <Button name="$parentCloseButton" inherits="EA_Button_DefaultResizeable">
                    <Size><AbsPoint x="120" y="39" /></Size>
                    <Anchors>
                        <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent"><AbsPoint x="-25" y="-15" /></Anchor>
                    </Anchors>
                    <EventHandlers><EventHandler event="OnLButtonUp" function="GearPreview.Close" /></EventHandlers>
                </Button>
            </Windows>
        </Window>
    </Windows>
</Interface>
